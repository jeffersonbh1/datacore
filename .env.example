# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database Configuration
# Find these in your Supabase project settings -> API (Project URL & anon public key)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Airbyte Gateway (frontend): URL of the deployed backend proxy that talks to Airbyte,
# and the shared key the gateway expects (must match GATEWAY_API_KEY below).
VITE_AIRBYTE_GATEWAY_URL="https://airbyte-gateway-xxxxx.run.app"
VITE_AIRBYTE_GATEWAY_API_KEY="your-shared-gateway-api-key"

# Airbyte Gateway (server-side only, never exposed to the browser)
# AIRBYTE_BASE_URL: internal IP of the Airbyte VM when deployed on Cloud Run with VPC egress;
# use the whitelisted external IP for local development instead.
AIRBYTE_BASE_URL="http://10.158.0.2:8000"
AIRBYTE_CLIENT_ID="your-airbyte-application-client-id"
AIRBYTE_CLIENT_SECRET="your-airbyte-application-client-secret"
AIRBYTE_WORKSPACE_ID="your-airbyte-workspace-id"
GATEWAY_API_KEY="your-shared-gateway-api-key"

# BigQuery (server-side only, never exposed to the browser): service account JSON
# (as a single-line string) used by the gateway to build the Bronze layer — for
# each table Airbyte replicates into a raw_ dataset, mirrors it into bronze_.
# Every empresa shares the same GCP project today, so one credential covers all.
BIGQUERY_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ---------------------------------------------------------------------------
# dbt (camada Bronze) — ver dbt/README.md
#
# A Bronze é 100% dbt. Ao criar a integração o gateway gera um modelo por tabela
# em dbt/models/medallion/bronze/<sistema>/bronze_<sistema>_<tabela>.sql
# (server/dbtCodegen.ts) — sobrescreve se já existir. Depois roda `dbt build
# --select bronze_<sistema>_<t1> ...` (server/dbtRunner.ts + routes/bronze.ts).
# Não há mais CREATE TABLE AS SELECT fora do dbt. projectId / rawDataset /
# bronzeDataset / location vêm da requisição.
# ---------------------------------------------------------------------------
# Caminho do executável dbt. Vazio = usa "dbt" do PATH (assim no container, onde
# o Dockerfile instala globalmente). Em dev local no Windows, se "dbt" não estiver
# no PATH, aponte para o venv (ver dbt/README.md), ex.:
# DBT_BIN="C:/dbt-venv/Scripts/dbt.exe"
DBT_BIN=""
DBT_GCP_PROJECT="your-gcp-project-id"
DBT_GCP_LOCATION="southamerica-east1"
# Dataset da zona RAW gerada pelo Airbyte (prefixo raw_). Ex.: raw_vendas
DBT_RAW_DATASET="raw"
# Datasets de saída (o gateway define DBT_SCHEMA_BRONZE = bronzeDataset da requisição)
DBT_SCHEMA_STAGING="staging"
DBT_SCHEMA_BRONZE="bronze"
DBT_SCHEMA_SILVER="silver"
DBT_SCHEMA_GOLD="gold"
# target do profiles.yml. No container o default é "prod"; local sem SA use "dev".
DBT_TARGET="dev"
# target "prod": caminho para o JSON da service account. Se vazio, o gateway
# materializa BIGQUERY_CREDENTIALS_JSON num arquivo temporário automaticamente.
DBT_GCP_KEYFILE="/secrets/bigquery-sa.json"
# Pasta do projeto dbt (no container: /app/dbt). Vazio = busca ./dbt subindo a árvore.
DBT_PROJECT_DIR=""
# Tempo máximo de cada invocação do dbt (ms). Default 900000 (15 min).
DBT_RUN_TIMEOUT_MS="900000"
# Parada de emergência: "true" faz toda construção de Bronze falhar (503), sem fallback.
DBT_DISABLED="false"
# Modelos de EXEMPLO (transacoes, em models/*/*_transacoes.sql). O gateway força
# "false"; deixe "true" só para rodar o exemplo com o seed localmente.
DBT_DEMO_ENABLED="true"

# Codegen (server/dbtCodegen.ts) escreve em dbt/models/medallion/bronze/:
#   off    (default) só escreve os arquivos
#   commit escreve e faz `git commit`
#   push   escreve, `git commit` e `git push` (precisa de remote com credencial)
DBT_CODEGEN_GIT="off"
GIT_AUTHOR_NAME="DataCore Gateway"
GIT_AUTHOR_EMAIL="gateway@datacore.local"
